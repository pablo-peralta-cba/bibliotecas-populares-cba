# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_key
CLOUDINARY_SECRET=your_secret

# Maptiler (used by both backend and client)
MAPTILER_API_KEY=your_key
VITE_MAPTILER_API_KEY=your_key

# MongoDB
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Session secret
SECRET=your_session_secret_min_32_chars

# Nodemailer
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Site URL
SITE_URL=http://localhost:3000
